[Unit]
Description=BlitzTrader Autonomous Trading Agent
After=network-online.target
Wants=network-online.target
Requires=rclone-blitztrader-drive.service
After=rclone-blitztrader-drive.service

[Service]
Type=simple
User=blitztrader
Group=blitztrader
WorkingDirectory=/opt/blitztrader
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/blitztrader/.env

ExecCondition=/opt/blitztrader/venv/bin/python scripts/is_trading_day.py
ExecStart=/opt/blitztrader/venv/bin/python main.py

# Graceful shutdown
KillSignal=SIGTERM
TimeoutStopSec=30

# Restart only on unexpected failures (not normal exit)
Restart=no

# Keep service-manager logs local. App/runtime artifacts can still use
# the configured runtime storage path and upload/export flow separately.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
