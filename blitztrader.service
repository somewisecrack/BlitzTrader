[Unit]
Description=BlitzTrader Autonomous Trading Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=blitztrader
Group=blitztrader
WorkingDirectory=/opt/blitztrader
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/blitztrader/.env

ExecCondition=/opt/blitztrader/venv/bin/python scripts/is_trading_day.py
# Runs as root (the '+' prefix) but only trims system caches and stale /tmp data.
ExecStartPre=+/opt/blitztrader/venv/bin/python scripts/disk_cleanup.py
ExecStart=/opt/blitztrader/venv/bin/python main.py

# Graceful shutdown
KillSignal=SIGTERM
TimeoutStopSec=30

# Restart only on unexpected failures (not normal exit)
Restart=no

# Keep service-manager logs local. Pair-credit mode records only position ledgers.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
