# GammaBlast environment configuration
# Copy to .env and fill in your credentials.
# NEVER share or commit .env.

# ── Shoonya credentials ───────────────────────────────────────────────────────
SHOONYA_USER_ID=
SHOONYA_PASSWORD=
SHOONYA_TOTP_SECRET=
SHOONYA_API_KEY=
SHOONYA_SECRET_CODE=
SHOONYA_VENDOR_CODE=
SHOONYA_IMEI=

# ── Telegram (GammaBlast-specific bot — NOT BlitzTrader's bot) ───────────────
GAMMABLAST_TELEGRAM_BOT_TOKEN=
GAMMABLAST_TELEGRAM_CHAT_ID=

# ── AI / Gemini (wiki-loop only, post-market) ─────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_TIMEOUT_SECONDS=60

# ── Runtime storage ───────────────────────────────────────────────────────────
# Default: /opt/gammablast (same dir as the app)
# RUNTIME_STORAGE_DIR=/opt/gammablast

# ── Google Drive backup (NOT BlitzTrader folder) ──────────────────────────────
RCLONE_REMOTE=gdrive
RCLONE_FOLDER=GammaBlast

# ── Virtual capital ───────────────────────────────────────────────────────────
VIRTUAL_CAPITAL=100000

# ── Instrument config ─────────────────────────────────────────────────────────
NIFTY_STRIKE_STEP=50
SENSEX_STRIKE_STEP=100
NIFTY_LOT_SIZE=25
SENSEX_LOT_SIZE=10

# ── Scan interval ─────────────────────────────────────────────────────────────
SCAN_INTERVAL_SECONDS=60

# ── Candidate engine thresholds ───────────────────────────────────────────────
VOLUME_BURST_RATIO=1.5
VOLUME_BURST_MIN_IN_WINDOW=2
PREMIUM_MAX_RATIO=1.25
OI_HIGH_RATIO=0.90
BID_IMBALANCE_MIN=0.3
MIN_CANDIDATE_SCORE=0.5

# ── Trailing exit ─────────────────────────────────────────────────────────────
TRAIL_ACTIVATION_MULT=2.0
TRAIL_INITIAL_FRACTION=0.40
TRAIL_TIGHT_MULT=4.0
TRAIL_TIGHT_FRACTION=0.25
HARD_STOP_FRACTION=0.50
STALE_DATA_SECONDS=300

# ── Drive mode ────────────────────────────────────────────────────────────────
# LIVE_DRIVE_MODE=false
