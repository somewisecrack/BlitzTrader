[Unit]
Description=GammaBlast Virtual Options Scanner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gammablast
Group=gammablast
WorkingDirectory=/opt/gammablast
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/gammablast/.env

ExecCondition=/opt/gammablast/venv/bin/python scripts/is_gammablast_day.py
ExecStart=/opt/gammablast/venv/bin/python main.py

KillSignal=SIGTERM
TimeoutStopSec=30
Restart=no

StandardOutput=journal
StandardError=journal
SyslogIdentifier=gammablast

[Install]
WantedBy=multi-user.target
