[Unit]
Description=GammaBlast Post-Market Wiki Loop
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=gammablast
Group=gammablast
WorkingDirectory=/opt/gammablast
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/gammablast/.env

ExecCondition=/opt/gammablast/venv/bin/python scripts/is_gammablast_day.py
ExecStart=/opt/gammablast/venv/bin/python scripts/run_gamma_wiki_loop.py

Restart=no
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gammablast-wiki-loop
