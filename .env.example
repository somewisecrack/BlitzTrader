# ──────────────────────────────────────────────────────────
#   BlitzTrader Environment Variables
#   Copy to .env and fill in your actual values.
# ──────────────────────────────────────────────────────────

# Shoonya API Credentials (from Finvasia)
SHOONYA_USER_ID=your_user_id
SHOONYA_PASSWORD=your_password
SHOONYA_API_KEY=your_api_key
SHOONYA_TOTP_SECRET=your_base32_totp_secret
SHOONYA_VENDOR_CODE=your_vendor_code
SHOONYA_IMEI=your_imei

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_AUTHORIZED_USER_ID=your_telegram_user_id

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Paths (optional — defaults to parent of BlitzTrader/)
# TRADING_FOLDER_PATH=/path/to/TRADING
